{
  "mcpServers": {
    "ssh-tasks": {
      "command": "npx",
      "args": ["ssh-mcp"],
      "env": {
        "SSH_HOST": "${TASKSFLOW_SSH_HOST:-tasksflow.ru}",
        "SSH_PORT": "${TASKSFLOW_SSH_PORT:-}",
        "SSH_USER": "${TASKSFLOW_SSH_USER:-}",
        "SSH_KEY_PATH": "${TASKSFLOW_SSH_KEY_PATH:-}"
      }
    }
  }
}
