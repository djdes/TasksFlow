#!/usr/bin/env sh
# Pre-commit gate для TasksFlow. По мотивам Wesetup anti-regression
# Phase 1 (docs/01-architecture.md).
#
# Защищает прод от очевидных регрессий ДО того как код попадает в master.
# Запускается автоматически на каждый `git commit`. Можно пропустить
# через `git commit --no-verify` (только если осознанно).

set -e

staged_ts=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' || true)

# Type-check на любые .ts/.tsx изменения. Быстро (~5 сек).
if [ -n "$staged_ts" ]; then
  echo "→ TypeScript type-check..."
  npx tsc --noEmit || {
    echo "✗ Type-check провалился. Поправьте ошибки или (только осознанно) --no-verify."
    exit 1
  }

  echo "→ ESLint (изменённые файлы)..."
  # Валят коммит только ошибки (хуки React, явные баги), предупреждения — нет.
  # shellcheck disable=SC2086
  npx eslint --no-warn-ignored $staged_ts || {
    echo "✗ ESLint нашёл ошибки. Поправьте или --no-verify (только осознанно)."
    exit 1
  }

  echo "→ Tests (связанные с изменёнными файлами)..."
  # Только тесты, которые импортируют изменённые файлы: секунды вместо
  # полного прогона на 30–40 с. Полный прогон — в CI на каждый push и PR.
  # shellcheck disable=SC2086
  npx vitest related --run --passWithNoTests $staged_ts || {
    echo "✗ Tests провалились. Почините или --no-verify (только осознанно)."
    exit 1
  }
fi

echo "✓ pre-commit OK"
