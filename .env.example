# Database (MySQL)
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=tasksflow

# Server
PORT=5001
SESSION_SECRET=your_random_secret_key_here_minimum_32_chars

# Email notifications (optional). Если SMTP_HOST не задан — уведомления
# о выполненных задачах не отправляются (silent skip с warning в логе).
#
# Прод (как на wesetup): локальный MTA FastPanel, без логина. Почтовый
# домен tasksflow.ru с DKIM живёт на том же сервере, он и подписывает.
# SMTP_HOST=localhost
# SMTP_PORT=25
# SMTP_FROM='"TasksFlow" <support@tasksflow.ru>'
#
# Внешний SMTP с авторизацией (dev / другой хостинг). Для Gmail нужен
# App Password (Google Account → Security → App passwords), не основной
# пароль аккаунта.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM='"TasksFlow" <noreply@yourcompany.ru>'
# DEFAULT_ADMIN_EMAIL=admin@example.com

# Базовый URL приложения для генерации ссылок-приглашений (/join/<token>).
# Если не задан — берётся из заголовков запроса (req.protocol + Host).
# PUBLIC_BASE_URL=https://tasksflow.example.com

# ===== Telegram-бот (@thetasksflowbot) =====
# Без TASKSFLOW_BOT_TOKEN модуль бота не стартует — сервер работает как раньше.
# TASKSFLOW_BOT_TOKEN=8810015596:AA...
# Нужен Login Widget'у на странице «Аккаунт» и для ссылки t.me/<username>.
# TELEGRAM_BOT_USERNAME=thetasksflowbot
# auto | webhook | polling | off.
# auto = webhook, если заданы URL и секрет; иначе long-poll getUpdates.
# Polling предпочтительнее за прокси: не требует входящей доступности вообще.
# TELEGRAM_MODE=auto
# TELEGRAM_WEBHOOK_URL=https://tasksflow.ru/api/telegram/webhook
# Обязателен для webhook-режима: без него вебхук отбрасывает все апдейты.
# TELEGRAM_WEBHOOK_SECRET=random_32_chars
# RU-хостинги местами не маршрутизируют подсети Telegram. Тогда либо прокси…
# TELEGRAM_HTTP_PROXY=http://user:pass@proxy-host:3128
# …либо свой relay вместо api.telegram.org.
# TELEGRAM_API_BASE_URL=https://tg-relay.example.com

# ===== Очередь AI-разбора задач (ProjectsFlow) =====
# Бот шлёт текст в очередь ProjectsFlow, воркер ralph зовёт Claude и
# возвращает JSON с сегментами. Если не задано — бот работает без AI:
# отдаёт ручной черновик, ничего не теряя.
# PF_API_URL=https://projectsflow.ru/api
# PF_AGENT_TOKEN=pfat_...
# PF_TASKSFLOW_PROJECT_ID=bcc868e6-853c-4c8b-a592-6f3fcb20a298

# ===== Ежедневный сброс задач и история =====
# Сервер сам сбрасывает повторяющиеся задачи в местную полночь компании
# (пояс — в настройках компании), вчерашний день уходит в историю с фото.
# Выключить встроенный планировщик (тогда сбрасывает только cron
# `npm run reset-tasks`): DAILY_RESET_SCHEDULER=off
# Фото в истории хранятся бессрочно. Чтобы удалять файлы старше N дней
# (не меньше 7), задайте PHOTO_RETENTION_DAYS. Записи истории остаются.
# PHOTO_RETENTION_DAYS=180

# ===== Тарифы =====
# Лимиты тарифов («Старт» — до 5 человек, «Команда» — до 30, точки — на
# «Бизнесе»). Пока не включено, тариф только показывается. Тариф компании
# root выставляет в кабинете: меню → «Root: компании и тарифы».
# PLAN_LIMITS=on

# ===== Приложения и push-уведомления (docs/mobile.md) =====
# Web Push (браузеры, установленное PWA, Android-приложение). Деплой создаёт
# ключи сам при первом запуске; сменить их = отвязать все устройства.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@tasksflow.ru
# Прокси до push-сервисов, если хостинг их не видит (как TELEGRAM_HTTP_PROXY).
# PUSH_HTTP_PROXY=http://user:pass@proxy:3128
# Доп. хосты push-сервисов через запятую (по умолчанию Google, Mozilla, Apple, Microsoft).
# PUSH_ENDPOINT_HOSTS=
#
# iOS-приложение: push через APNs. Ключ — Apple Developer → Keys → «Apple Push
# Notifications service» (.p8). APNS_KEY — содержимое файла (PEM, можно в одну
# строку с \n или base64).
# APNS_KEY_ID=
# APNS_KEY=
# APPLE_TEAM_ID=            # он же включает /.well-known/apple-app-site-association
# APNS_BUNDLE_ID=ru.tasksflow.app
#
# Android: отпечаток SHA-256 ключа подписи Google Play (Play Console → App
# integrity), если приложение ставят из Play. Ключ APK с сайта CI добавляет сам.
# ANDROID_CERT_SHA256=AB:CD:...
#
# Ссылки на магазины — показываются на /app и в «Аккаунте», когда заданы.
# ANDROID_PLAY_URL=https://play.google.com/store/apps/details?id=ru.tasksflow.app
# ANDROID_RUSTORE_URL=https://www.rustore.ru/catalog/app/ru.tasksflow.app
# IOS_APP_STORE_URL=https://apps.apple.com/app/id...
# IOS_TESTFLIGHT_URL=https://testflight.apple.com/join/...

# ===== Оплата тарифов: Робокасса (docs/billing.md) =====
# Кабинет магазина → «Технические настройки». Можно задать GitHub Secrets с
# теми же именами — деплой запишет их сюда. Без логина и обоих паролей
# текущего режима кнопки оплаты нет: «Онлайн-оплата скоро появится».
# ROBOKASSA_MERCHANT_LOGIN=      # идентификатор магазина
# ROBOKASSA_PASSWORD1=           # Пароль #1: подпись оплаты
# ROBOKASSA_PASSWORD2=           # Пароль #2: проверка уведомления на ResultURL
# ROBOKASSA_TEST_PASSWORD1=      # тестовые пароли — для ROBOKASSA_IS_TEST=1
# ROBOKASSA_TEST_PASSWORD2=
# ROBOKASSA_IS_TEST=1            # 1 — платежи в тестовом режиме, деньги не списываются
# ROBOKASSA_HASH=md5             # алгоритм подписи, как в кабинете: md5, sha256, sha512…
# ROBOKASSA_RECURRING=1          # включать, когда Робокасса подключит магазину рекуррентные платежи
# ROBOKASSA_SEND_RECEIPT=1       # передавать чек (Робочеки / своя касса)
# ROBOKASSA_RECEIPT_SNO=usn_income  # система налогообложения в чеке; пусто — из настроек магазина
# ROBOKASSA_RECEIPT_TAX=none     # ставка НДС позиции: none, vat0, vat10, vat20…

# ===== Реквизиты в документах (/privacy, /consent, /terms, /offer) =====
# Пока не заданы, на страницах видны заметные плейсхолдеры. Робокасса при
# подключении магазина проверяет оферту и реквизиты — заполните до заявки.
# LEGAL_OPERATOR_NAME=ИП Иванов Иван Иванович
# LEGAL_OPERATOR_INN=
# LEGAL_OPERATOR_OGRN=           # 13 цифр — ОГРН, 15 — ОГРНИП
# LEGAL_OPERATOR_ADDRESS=
# LEGAL_CONTACT_EMAIL=support@tasksflow.ru
# LEGAL_UPDATED_AT=2026-10-24    # дата редакции; пусто — из файлов content/legal
