      "MYSQL_HOST",
      "MYSQL_PORT",
      "MYSQL_USER",
      "MYSQL_PASSWORD",
      "MYSQL_DATABASE"
    ],
    "nodePath": "~/www/tasksflow.ru/node_modules"
  }
}
