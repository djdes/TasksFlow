{
  "project": "tasksflow",
  "repo": "djdes/TasksFlow",
  "workflow": "claude-ops.yml",
  "ref": "main",
  "appDir": "~/www/tasksflow.ru",
  "pm2": [
    "tasksflow"
  ],
  "health": "https://tasksflow.ru/api/health",
  "db": {
    "envFile": "~/www/tasksflow.ru/.env",
